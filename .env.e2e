# Settings for end-to-end tests (npm run test:e2e builds with --mode e2e).
# These override .env.local. The Supabase address is deliberately unreachable:
# tests fake its answers and never touch a real project. No CAPTCHA in tests.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_e2e_not_a_real_key
VITE_SITE_URL=http://localhost:4173/
VITE_TURNSTILE_SITE_KEY=
